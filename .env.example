# Copy this file to ".env" and change what you need. ".env" is git-ignored.

# Where Ollama (the program that runs the model) is listening.
# On a university server this becomes e.g. http://10.0.0.5:11434
OLLAMA_URL=http://localhost:11434

# Which model to use (must be downloaded first: ollama pull <name>)
MODEL=qwen2.5-coder:3b

# How much text the model can see at once (tokens). The system prompt describes
# every QGIS tool (~100,000 tokens), so use a model that supports at least
# 128k tokens, e.g. on a VM:
#   MODEL=qwen3-coder:30b
#   OLLAMA_URL=http://<vm-address>:11434
CONTEXT_TOKENS=32768

# How many times the agent may fix its own code after an error.
MAX_FIX_ATTEMPTS=3

# Optional: path to QGIS Desktop's launcher if it is not found automatically.
# QGIS_DESKTOP=C:\Program Files\QGIS 3.44.11\bin\qgis.bat
